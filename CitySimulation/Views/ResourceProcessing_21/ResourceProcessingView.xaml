<UserControl x:Class="CitySimulation.Views.ResourceProcessing_21.ResourceProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid MinHeight="600" MinWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="⚙️ Переработка ресурсов в материалы (Вариант 21)" 
                      FontSize="20" FontWeight="Bold" Margin="10" Padding="10"/>

            <TabControl Grid.Row="1" Margin="10">
                <TabItem Header="Перерабатывающие объекты">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Список объектов:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding ResourceProcessingVM_21.Facilities}" 
                                     SelectedItem="{Binding ResourceProcessingVM_21.SelectedFacility}"
                                     Height="200" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding InputResourceType, StringFormat='Сырье: {0} →'}" FontSize="10"/>
                                            <TextBlock Text="{Binding OutputMaterialType, StringFormat='Материал: {0}'}" FontSize="10"/>
                                            <TextBlock Text="{Binding InputStorage, StringFormat='Сырье: {0:N0}'}" FontSize="9"/>
                                            <TextBlock Text="{Binding OutputStorage, StringFormat='Материал: {0:N0}'}" FontSize="9"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="Запустить переработку" 
                                    Command="{Binding ResourceProcessingVM_21.ProcessResourcesCommand}"
                                    Width="150" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Добавить новый объект:" FontWeight="Bold" Margin="0,0,0,10"/>

                            <StackPanel>
                                <TextBlock Text="Название объекта:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewFacilityName}" Height="25" Margin="0,0,0,10"/>

                                <TextBlock Text="Адрес:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewFacilityAddress}" Height="25" Margin="0,0,0,10"/>

                                <TextBlock Text="Входное сырье:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewFacilityInputResource}" Height="25" Margin="0,0,0,10"/>

                                <TextBlock Text="Выходной материал:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewFacilityOutputMaterial}" Height="25" Margin="0,0,0,10"/>

                                <TextBlock Text="Скорость переработки:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewFacilityProcessingRate}" Height="25" Margin="0,0,0,10"/>

                                <Button Content="Добавить объект" 
                                        Command="{Binding ResourceProcessingVM_21.AddFacilityCommand}"
                                        Width="120" Height="30"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Технологические установки">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Технологические установки:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding ResourceProcessingVM_21.ProcessingUnits}" 
                                     SelectedItem="{Binding ResourceProcessingVM_21.SelectedUnit}"
                                     Height="200" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding UnitType, StringFormat='Тип: {0}'}"/>
                                            <TextBlock Text="{Binding Capacity, StringFormat='Мощность: {0}'}"/>
                                            <TextBlock Text="{Binding IsOperational, StringFormat='Статус: {0}'}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Вкл/Выкл" 
                                        Command="{Binding ResourceProcessingVM_21.ToggleUnitCommand}"
                                        Width="100" Height="30"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Добавить новую установку:" FontWeight="Bold" Margin="0,0,0,10"/>

                            <StackPanel>
                                <TextBlock Text="Название установки:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewUnitName}" Height="25" Margin="0,0,0,10"/>

                                <TextBlock Text="Тип установки:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewUnitType}" Height="25" Margin="0,0,0,10"/>

                                <TextBlock Text="Мощность:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding ResourceProcessingVM_21.NewUnitCapacity}" Height="25" Margin="0,0,0,10"/>

                                <Button Content="Добавить установку" 
                                        Command="{Binding ResourceProcessingVM_21.AddUnitCommand}"
                                        Width="140" Height="30"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <StatusBar Grid.Row="2">
                <TextBlock Text="{Binding ResourceProcessingVM_21.StatusMessage}" FontWeight="Bold"/>
            </StatusBar>
        </Grid>
    </ScrollViewer>
</UserControl>